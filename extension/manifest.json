{
  "manifest_version": 3,
  "name": "Compasso — Navegação em foco",
  "version": "4.0.0",
  "icons": {"16":"icon-16.png","32":"icon-32.png","48":"icon-48.png","128":"icon-128.png"},
  "description": "Aplica a lista de sites do seu Compasso local somente durante uma sessão de foco autorizada.",
  "permissions": ["declarativeNetRequestWithHostAccess", "alarms", "storage", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Compasso", "default_icon":{"16":"icon-16.png","32":"icon-32.png"}},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["policy.js", "content.js"], "run_at": "document_start"}],
  "web_accessible_resources": [{"resources": ["blocked.html", "brand.svg"], "matches": ["http://*/*", "https://*/*"]}]
}
