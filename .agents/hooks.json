{
  "post_tool": [
    {
      "tools": ["write_to_file", "replace_file_content", "run_command"],
      "condition": "args.get('TargetFile', '').endswith('.tex') or args.get('TargetFile', '').endswith('.bib')",
      "command": "python qa.py . --static-only --no-render --file \"{args.TargetFile}\"",
      "description": "Linter estático focado no arquivo modificado. Se houver erro, ABORTE e informe o usuário o que falhou."
    }
  ]
}
